<Window x:Class="Atoll.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Atoll — Dynamic Island for Windows"
        Width="700" Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0A"
        FontFamily="SF Pro Display, SF Pro Text, Segoe UI Variable, Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 16">
            <TextBlock Text="ATOLL" FontSize="20" FontWeight="Bold"
                       Foreground="#0A84FF" VerticalAlignment="Center" Margin="0 0 8 0"/>
            <TextBlock Text="— Dynamic Island for Windows" FontSize="14"
                       Foreground="#999999" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#161616" CornerRadius="12" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Width="200">
                    <TextBlock Text="TABS" FontSize="11" FontWeight="Bold"
                               Foreground="#666666" Margin="0 0 12 12"/>
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Margin="0 0 0 8"
                                        Foreground="#FFFFFF" Background="Transparent"
                                        BorderThickness="0" HorizontalAlignment="Left"
                                        Padding="8 6" FontSize="13"
                                        Click="OnTabClick"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="24 0 0 0">
                    <TextBlock Text="CURRENT TAB" FontSize="11" FontWeight="Bold"
                               Foreground="#666666" Margin="0 0 8 4"/>
                    <TextBlock Text="{Binding CurrentView}" FontSize="18" Foreground="#FFFFFF"/>
                    <TextBlock Text="{Binding TabSwitchForward, StringFormat='Direction: {0}'}"
                               FontSize="12" Foreground="#999999" Margin="0 8 0 0"/>

                    <TextBlock Text="MEDIA" FontSize="11" FontWeight="Bold"
                               Foreground="#666666" Margin="0 24 8 4"/>
                    <Border Background="#0F0F0F" CornerRadius="8" Padding="10" Margin="0 0 0 8">
                        <StackPanel>
                            <TextBlock Text="{Binding MediaState.Title, TargetNullValue='—', FallbackValue='—'}"
                                       FontSize="15" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MediaState.Artist, TargetNullValue='—', FallbackValue='—'}"
                                       FontSize="13" Foreground="#999999" Margin="0 4 0 0"/>
                            <TextBlock Text="{Binding MediaState.IsPlaying, StringFormat='Playing: {0}', FallbackValue='Playing: False'}"
                                       FontSize="11" Foreground="#0A84FF" Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SYSTEM METRICS" FontSize="11" FontWeight="Bold"
                               Foreground="#666666" Margin="0 24 8 4"/>
                    <Border Background="#0F0F0F" CornerRadius="8" Padding="10" Margin="0 0 0 8">
                        <StackPanel>
                            <TextBlock Text="{Binding MetricsSnapshot.CpuTotalPercent, StringFormat='CPU: {0:F1}%', TargetNullValue='CPU: —', FallbackValue='CPU: —'}"
                                       FontSize="13" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding MetricsSnapshot.MemoryUsedPercent, StringFormat='Memory: {0:F1}%', TargetNullValue='Memory: —', FallbackValue='Memory: —'}"
                                       FontSize="13" Foreground="#FFFFFF" Margin="0 4 0 0"/>
                            <TextBlock Text="{Binding MetricsSnapshot.NetworkBytesSentPerSec, StringFormat='Net ↑: {0:N0} B/s', TargetNullValue='Net ↑: —', FallbackValue='Net ↑: —'}"
                                       FontSize="11" Foreground="#999999" Margin="0 8 0 0"/>
                            <TextBlock Text="{Binding MetricsSnapshot.NetworkBytesReceivedPerSec, StringFormat='Net ↓: {0:N0} B/s', TargetNullValue='Net ↓: —', FallbackValue='Net ↓: —'}"
                                       FontSize="11" Foreground="#999999"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="NOTCHES (per display)" FontSize="11" FontWeight="Bold"
                               Foreground="#666666" Margin="0 24 8 4"/>
                    <ItemsControl ItemsSource="{Binding Notches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0F0F0F" CornerRadius="8" Padding="10" Margin="0 0 0 8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding State, StringFormat='Notch: {0}'}"
                                                   Foreground="#0A84FF" FontWeight="SemiBold"/>
                                        <TextBlock Text="   size: " Foreground="#666666" FontSize="11"/>
                                        <TextBlock Text="{Binding CurrentWidth, StringFormat='F0'}"
                                                   Foreground="#CCCCCC" FontSize="11"/>
                                        <TextBlock Text="×" Foreground="#666666" FontSize="11"/>
                                        <TextBlock Text="{Binding CurrentHeight, StringFormat='F0'}"
                                                   Foreground="#CCCCCC" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
            <Button Content="Open All Notches" Width="130" Click="OnOpenAll" Margin="0 0 10 0"/>
            <Button Content="Close All Notches" Width="130" Click="OnCloseAll" Margin="0 0 10 0"/>
            <Button Content="Open Settings" Width="120" Click="OnOpenSettings"/>
        </StackPanel>
    </Grid>
</Window>
