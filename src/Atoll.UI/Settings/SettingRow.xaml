<UserControl x:Class="Atoll.UI.Settings.SettingRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="520" d:DesignHeight="48">
    <UserControl.Resources>
        <!-- macOS-style toggle switch built on CheckBox so the code-behind
             (IsChecked / Checked / Unchecked) is unchanged. -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track" Width="40" Height="24" CornerRadius="12"
                                Background="#39393D">
                            <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#FFFFFF"
                                     HorizontalAlignment="Left" Margin="2 0 0 0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#30D158"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0 0 2 0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#15FFFFFF" BorderThickness="0 0 0 1">
        <Grid Margin="4 11 4 11">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0 0 16 0">
                <TextBlock x:Name="KeyLabel" FontSize="13.5" Foreground="#F2F2F2"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MetaLabel" FontSize="11" Foreground="#6E6E73"
                           Margin="0 2 0 0" TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="BoolEditor" Style="{StaticResource ToggleSwitch}"
                          Visibility="Collapsed"
                          Checked="OnBoolChanged" Unchecked="OnBoolChanged"/>
                <TextBox x:Name="TextEditor" Width="210" Visibility="Collapsed" VerticalAlignment="Center"
                         Background="#2C2C2E" Foreground="#F2F2F2" BorderBrush="#3A3A3C"
                         Padding="8 5" FontSize="12.5"
                         LostFocus="OnTextLostFocus" TextChanged="OnTextChanged"/>
                <ComboBox x:Name="EnumEditor" Width="180" Visibility="Collapsed" VerticalAlignment="Center"
                          Background="#2C2C2E" Foreground="#F2F2F2" BorderBrush="#3A3A3C"
                          FontSize="12.5" SelectionChanged="OnEnumChanged"/>
                <Border x:Name="ColorSwatch" Width="20" Height="20" CornerRadius="5"
                        Margin="8 0 0 0" BorderBrush="#4A4A4C" BorderThickness="1"
                        Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
