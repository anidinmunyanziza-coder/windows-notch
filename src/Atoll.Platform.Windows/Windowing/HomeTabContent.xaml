<UserControl x:Class="Atoll.Platform.Windows.Windowing.HomeTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Atoll.Platform.Windows.Windowing"
             mc:Ignorable="d"
             d:DesignWidth="420" d:DesignHeight="181">
    <!--
        Apple-style Now Playing, modelled on the iPhone Dynamic Island's expanded
        player and macOS Control Center: large rounded artwork, a semibold title
        over a secondary-grey artist, an album-tinted waveform, a hairline
        scrubber with inline times, and borderless SF-Symbol-style transport
        glyphs (drawn, never font icons) that get a soft circle on hover and
        shrink when pressed.
    -->
    <UserControl.Resources>
        <local:ArtworkConverter x:Key="Artwork"/>
        <local:IsNullToVisibilityConverter x:Key="NullToVis"/>

        <!-- SF Symbols-style glyphs on a 24x24 grid -->
        <Geometry x:Key="PlayFill">M 7.2,4.9 C 7.2,3.9 8.3,3.3 9.1,3.8 L 19.6,10.4 C 20.4,10.9 20.4,12.1 19.6,12.6 L 9.1,19.2 C 8.3,19.7 7.2,19.1 7.2,18.1 Z</Geometry>
        <Geometry x:Key="PauseFill">M 6.4,4.6 C 6.4,3.9 7,3.4 7.6,3.4 H 9.4 C 10.1,3.4 10.6,3.9 10.6,4.6 V 19.4 C 10.6,20.1 10.1,20.6 9.4,20.6 H 7.6 C 7,20.6 6.4,20.1 6.4,19.4 Z M 13.4,4.6 C 13.4,3.9 14,3.4 14.6,3.4 H 16.4 C 17.1,3.4 17.6,3.9 17.6,4.6 V 19.4 C 17.6,20.1 17.1,20.6 16.4,20.6 H 14.6 C 14,20.6 13.4,20.1 13.4,19.4 Z</Geometry>
        <Geometry x:Key="ForwardFill">M 1.6,6.9 C 1.6,6 2.6,5.5 3.3,6 L 10.9,11.1 C 11.5,11.5 11.5,12.5 10.9,12.9 L 3.3,18 C 2.6,18.5 1.6,18 1.6,17.1 Z M 11.9,6.9 C 11.9,6 12.9,5.5 13.6,6 L 21.2,11.1 C 21.8,11.5 21.8,12.5 21.2,12.9 L 13.6,18 C 12.9,18.5 11.9,18 11.9,17.1 Z</Geometry>
        <Geometry x:Key="ShuffleLine">M 3,7.5 H 6.2 C 9.8,7.5 11.2,16.5 14.8,16.5 H 20 M 3,16.5 H 6.2 C 7.8,16.5 8.9,14.7 9.8,12.8 M 12.9,10 C 13.6,8.6 14.3,7.5 14.8,7.5 H 20 M 17.6,5 L 20.2,7.5 L 17.6,10 M 17.6,14 L 20.2,16.5 L 17.6,19</Geometry>
        <Geometry x:Key="RepeatLine">M 4.2,11.4 V 10 C 4.2,8.4 5.4,7.2 7,7.2 H 19.2 M 16.6,4.6 L 19.2,7.2 L 16.6,9.8 M 19.8,12.6 V 14 C 19.8,15.6 18.6,16.8 17,16.8 H 4.8 M 7.4,19.4 L 4.8,16.8 L 7.4,14.2</Geometry>

        <!-- Borderless transport button: soft halo on hover, press-shrink. -->
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse x:Name="Halo" Fill="#FFFFFF" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.09"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="0.16"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.86" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28">
                                                <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.5"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="MediaPanel" Margin="20 2 20 8" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Artwork · title / artist · waveform ─────────────────────── -->
        <Grid Grid.Row="0" Height="58">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Album art — matched-geometry target of the closed pill's art.
                 Dims and shrinks while paused, like the original. -->
            <Grid x:Name="ArtHost" Grid.Column="0" Width="58" Height="58" VerticalAlignment="Center">
                <Grid x:Name="ArtVisual" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ArtScale" ScaleX="1" ScaleY="1"/>
                    </Grid.RenderTransform>
                    <Border CornerRadius="12" Background="#2C2C2E"/>
                    <!-- music.note placeholder -->
                    <Path Data="M 5.5,17.6 A 2.6,2.2 0 1 0 10.7,17.6 A 2.6,2.2 0 1 0 5.5,17.6 Z M 13.3,15.6 A 2.6,2.2 0 1 0 18.5,15.6 A 2.6,2.2 0 1 0 13.3,15.6 Z M 10.7,17.6 V 6 L 18.5,4.2 V 15.6"
                          Stroke="#636366" StrokeThickness="1.7" Fill="#636366" StrokeLineJoin="Round" Width="22" Height="22" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding MediaState.ArtworkBytes, Converter={StaticResource NullToVis}}"/>
                    <Border x:Name="ArtImage" CornerRadius="12">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding MediaState.ArtworkBytes, Converter={StaticResource Artwork}}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <!-- hairline edge, like artwork in Apple Music -->
                    <Border CornerRadius="12" BorderBrush="#1AFFFFFF" BorderThickness="0.75"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14 0 12 0">
                <TextBlock x:Name="TitleText"
                           Text="{Binding MediaState.Title, TargetNullValue='Not Playing', FallbackValue='Not Playing'}"
                           FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="ArtistText" Text="{Binding MediaState.Artist, TargetNullValue='', FallbackValue=''}"
                           FontSize="13" Foreground="#9B9BA1" Margin="0 2 0 0"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>

            <!-- Album-tinted waveform — matched-geometry target of the pill's bars -->
            <Grid x:Name="SpectrumHost" Grid.Column="2" VerticalAlignment="Center" Margin="0 0 2 0">
                <local:SpectrumBars BarCount="4" BarWidth="3" BarHeight="20"/>
            </Grid>
        </Grid>

        <!-- ── Scrubber: elapsed · hairline track · remaining ───────────── -->
        <Grid Grid.Row="1" Margin="0 14 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" Grid.Column="0" Style="{StaticResource TimeText}"
                       TextAlignment="Left" Text="0:00"/>
            <!-- Taller transparent hit area so the thin track is easy to grab -->
            <Grid x:Name="ScrubArea" Grid.Column="1" Height="18" Background="Transparent" Cursor="Hand"
                  Margin="6 0 6 0">
                <Border x:Name="Track" Height="5" CornerRadius="3" Background="#33FFFFFF"
                        VerticalAlignment="Center">
                    <Border x:Name="TrackFill" HorizontalAlignment="Left" Width="0"
                            CornerRadius="3" Background="#E6FFFFFF"/>
                </Border>
            </Grid>
            <TextBlock x:Name="RemainingText" Grid.Column="2" Style="{StaticResource TimeText}"
                       TextAlignment="Right" Text="-0:00"/>
        </Grid>

        <!-- ── Transport ─────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 8 0 0">
            <Button x:Name="ShuffleButton" Style="{StaticResource TransportButton}" Width="34" Height="34"
                    ToolTip="Shuffle" Click="OnShuffle" Foreground="#8E8E93">
                <Grid Width="26" Height="26">
                    <Border x:Name="ShuffleActiveBg" CornerRadius="7" Background="#26FFFFFF" Visibility="Collapsed"/>
                    <Path Data="{StaticResource ShuffleLine}" Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Grid>
            </Button>

            <Button Style="{StaticResource TransportButton}" Width="46" Height="46" Margin="16 0 0 0"
                    ToolTip="Previous" Click="OnPrevious">
                <Path Data="{StaticResource ForwardFill}" Width="25" Height="25" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform><ScaleTransform ScaleX="-1"/></Path.RenderTransform>
                </Path>
            </Button>

            <Button Style="{StaticResource TransportButton}" Width="54" Height="54" Margin="14 0 14 0"
                    ToolTip="Play/Pause" Click="OnPlayPause">
                <Grid Width="30" Height="30">
                    <Path x:Name="PlayGlyph" Data="{StaticResource PlayFill}" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><ScaleTransform x:Name="PlayScale" ScaleX="1" ScaleY="1"/></Path.RenderTransform>
                    </Path>
                    <Path x:Name="PauseGlyph" Data="{StaticResource PauseFill}" Stretch="Uniform" Opacity="0"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><ScaleTransform x:Name="PauseScale" ScaleX="0.6" ScaleY="0.6"/></Path.RenderTransform>
                    </Path>
                </Grid>
            </Button>

            <Button Style="{StaticResource TransportButton}" Width="46" Height="46" Margin="0 0 16 0"
                    ToolTip="Next" Click="OnNext">
                <Path Data="{StaticResource ForwardFill}" Width="25" Height="25" Stretch="Uniform"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>

            <Button x:Name="RepeatButton" Style="{StaticResource TransportButton}" Width="34" Height="34"
                    ToolTip="Repeat" Click="OnRepeat" Foreground="#8E8E93">
                <Grid Width="26" Height="26">
                    <Border x:Name="RepeatActiveBg" CornerRadius="7" Background="#26FFFFFF" Visibility="Collapsed"/>
                    <Path Data="{StaticResource RepeatLine}" Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    <!-- repeat.1 badge -->
                    <TextBlock x:Name="RepeatOneBadge" Text="1" FontSize="7.5" FontWeight="Bold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 0.5"
                               Visibility="Collapsed"/>
                </Grid>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
