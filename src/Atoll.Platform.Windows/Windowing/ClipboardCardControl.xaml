<UserControl x:Class="Atoll.Platform.Windows.Windowing.ClipboardCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="290" d:DesignHeight="48"
             Focusable="False"
             Cursor="Hand">
    <UserControl.Resources>
        <Style x:Key="CardDeleteButton" TargetType="Button">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="ToolTip" Value="Delete this item"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#99000000" CornerRadius="9">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="8" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver,
                    RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Root" CornerRadius="12" BorderThickness="1"
            BorderBrush="#330A84FF" Padding="8" MinHeight="46">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#14FFFFFF"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1FFFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thumbnail / type icon. The border's rounded background also
                 accepts an ImageBrush for image entries, which clips to the
                 corner radius the same way the SwiftUI thumbnail does. -->
            <Grid Width="28" Height="28" Margin="0 0 10 0" VerticalAlignment="Center">
                <Border x:Name="ThumbnailHost" CornerRadius="6" Background="#0FFFFFFF"/>
                <TextBlock x:Name="IconGlyph" Text="&#xE8A5;"
                           FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Foreground="#0A84FF"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Border x:Name="CopiedOverlay" CornerRadius="6"
                        Background="#80000000" Visibility="Collapsed">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13" Foreground="#30D158"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0 0 12 0">
                <TextBlock x:Name="PreviewText" FontSize="13" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Grid Margin="0 2 0 0">
                    <TextBlock x:Name="TypeText" FontSize="10" Foreground="#8E8E93"
                               HorizontalAlignment="Left"/>
                    <TextBlock x:Name="TimeText" FontSize="10" Foreground="#8E8E93"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <Button x:Name="DeleteButton" Grid.Column="1"
                    Style="{StaticResource CardDeleteButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="OnDeleteClick"/>
        </Grid>
    </Border>
</UserControl>
