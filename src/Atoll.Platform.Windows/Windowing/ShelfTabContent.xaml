<UserControl x:Class="Atoll.Platform.Windows.Windowing.ShelfTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             AllowDrop="True"
             d:DesignWidth="420" d:DesignHeight="181">
    <UserControl.Resources>
        <Style x:Key="AirDropButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Disc" Width="46" Height="46" Fill="#1F1F21"/>
                            <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                       Foreground="#E6E6E6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="#2C2C2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Disc" Property="Fill" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12 2 12 10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- AirDrop (Windows: Nearby Share via the system share sheet) -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2 0 12 0">
            <Button x:Name="AirDropButton" Style="{StaticResource AirDropButton}"
                    ToolTip="Share shelf items (Nearby Share)" Click="OnAirDrop"/>
            <TextBlock Text="AirDrop" FontSize="10.5" Foreground="#C8C8CC"
                       HorizontalAlignment="Center" Margin="0 5 0 0"/>
        </StackPanel>

        <!-- Drop zone: dashed blue rounded rectangle, as in the original -->
        <Grid Grid.Column="1">
            <Rectangle RadiusX="14" RadiusY="14" Fill="Transparent"
                       Stroke="#0A84FF" StrokeThickness="1.6" StrokeDashArray="4 3"/>

            <ScrollViewer x:Name="ItemsScroller" VerticalScrollBarVisibility="Hidden" Margin="6">
                <WrapPanel x:Name="ItemsPanel" Orientation="Horizontal"/>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                        IsHitTestVisible="False">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                           Foreground="#C8C8CC" HorizontalAlignment="Center"/>
                <TextBlock Text="Drop files here" FontSize="12" Foreground="#9A9A9E"
                           HorizontalAlignment="Center" Margin="0 7 0 0"/>
            </StackPanel>

            <Button x:Name="ClearButton" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0 6 8 0" Cursor="Hand" ToolTip="Clear shelf" Click="OnClear"
                    Width="22" Height="20" Background="Transparent" BorderThickness="0"
                    Foreground="#FF453A" FontFamily="Segoe MDL2 Assets" FontSize="12"
                    Content="&#xE74D;" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
