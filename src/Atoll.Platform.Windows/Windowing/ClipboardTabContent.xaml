<UserControl x:Class="Atoll.Platform.Windows.Windowing.ClipboardTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="640" d:DesignHeight="200">
    <UserControl.Resources>
        <Style x:Key="HeaderIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Clear History"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1AFFFFFF" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="12 5"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DestructiveButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Foreground" Value="#FF453A"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: "Clipboard" + hover-independent trash button (hidden when empty). -->
        <Grid Grid.Row="0" Margin="20 8 20 12">
            <TextBlock Text="Clipboard" FontSize="16" FontWeight="SemiBold"
                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <Button x:Name="ClearButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource HeaderIconButton}" Click="OnRequestClear"
                    AutomationProperties.Name="Clear History">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="#FF453A"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Scrollbar hidden; wheel/trackpad scrolling still works. -->
            <ScrollViewer x:Name="HistoryScroller" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="20 0 20 20">
                <UniformGrid x:Name="CardsPanel" Columns="2" HorizontalAlignment="Stretch"
                             VerticalAlignment="Top"/>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0 0 0 8">
                <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                           Foreground="#4CFFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="No copies yet" FontSize="15" FontWeight="SemiBold"
                           Foreground="#999999" HorizontalAlignment="Center" Margin="0 8 0 0"/>
                <TextBlock Text="Copy something to see it here" FontSize="11"
                           Foreground="#70999999" HorizontalAlignment="Center" Margin="0 2 0 0"/>
            </StackPanel>
        </Grid>

        <!-- Clear-history confirmation, matching the original alert copy. -->
        <Grid x:Name="ClearOverlay" Grid.RowSpan="2" Background="#B3000000"
              Visibility="Collapsed" Panel.ZIndex="10">
            <Border Width="330" Background="#1C1C1E" BorderBrush="#2A2A2A"
                    BorderThickness="1" CornerRadius="14" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Clear Clipboard History?" FontSize="14"
                               FontWeight="SemiBold" Foreground="#FFFFFF"/>
                    <TextBlock Text="This removes every saved clipboard item from the notch tab."
                               FontSize="11.5" Foreground="#AAAAAA" TextWrapping="Wrap"
                               Margin="0 6 0 14"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource DialogButton}"
                                Click="OnCancelClear"/>
                        <Button Content="Clear History" Style="{StaticResource DestructiveButton}"
                                Margin="8 0 0 0" Click="OnConfirmClear"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
