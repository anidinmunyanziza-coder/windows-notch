<UserControl x:Class="Atoll.Platform.Windows.Windowing.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="420" d:DesignHeight="145">
    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#C8C8CC"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16 4 16 8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: month header + weekday row + day grid -->
        <StackPanel Grid.Column="0">
            <Grid Margin="0 0 0 4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MonthLabel" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="YearLabel" FontSize="17" Foreground="#8A8A8E" Margin="6 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PrevButton" Style="{StaticResource NavButton}" Content="&#xE76B;" Click="OnPrev"/>
                    <Button x:Name="TodayButton" Style="{StaticResource NavButton}" Content="&#xE8D1;" Width="24" ToolTip="Today" Click="OnToday"/>
                    <Button x:Name="NextButton" Style="{StaticResource NavButton}" Content="&#xE76C;" Click="OnNext"/>
                </StackPanel>
            </Grid>

            <UniformGrid x:Name="WeekdayRow" Columns="7" Margin="0 0 0 2"/>
            <UniformGrid x:Name="DaysGrid" Columns="7"/>
        </StackPanel>

        <!-- Right: events placeholder -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Margin="18 0 0 0" Width="110">
            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="#0A84FF" HorizontalAlignment="Center"/>
            <TextBlock Text="No events today" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"
                       HorizontalAlignment="Center" Margin="0 6 0 0" TextAlignment="Center"/>
            <TextBlock Text="Enjoy your free time!" FontSize="10.5" Foreground="#8A8A8E"
                       HorizontalAlignment="Center" Margin="0 1 0 0" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
