<UserControl x:Class="Atoll.Platform.Windows.Windowing.ClosedTimerActivity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="240" d:DesignHeight="32">
    <Grid Margin="12 0 14 0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Depleting ring -->
            <Grid Width="18" Height="18" Margin="0 0 9 0">
                <Ellipse Stroke="#3A3A3C" StrokeThickness="2.5"/>
                <Path x:Name="Ring" Stroke="#FF9F0A" StrokeThickness="2.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Grid>
            <TextBlock x:Name="TimeText" Text="0:00" FontSize="14" FontWeight="SemiBold"
                       Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <TextBlock x:Name="NameText" Text="" FontSize="11.5" Foreground="#9A9A9E"
                       VerticalAlignment="Center" Margin="8 0 0 0"
                       TextTrimming="CharacterEllipsis" MaxWidth="120"/>
        </StackPanel>
    </Grid>
</UserControl>
