<Application x:Class="Atoll.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="NotchSurfaceBrush" Color="#000000"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#0A84FF"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#999999"/>

            <!-- Tray context menu, matching Atoll's dark chrome. -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="#161616"/>
                <Setter Property="Foreground" Value="#E6E6E6"/>
                <Setter Property="BorderBrush" Value="#2A2A2A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="HasDropShadow" Value="True"/>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="#E6E6E6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent"
                                    CornerRadius="4" Padding="12 6"
                                    MinWidth="180" MinHeight="30">
                                <ContentPresenter ContentSource="Header"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0A84FF"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Margin" Value="6 4"/>
                <Setter Property="Background" Value="#2A2A2A"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Background="{TemplateBinding Background}" Height="1"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
